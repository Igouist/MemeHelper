{
  // 綁定位址寫在這裡才會跟著 publish 出去；launchSettings.json 只在 dotnet run 時生效。
  // 綁 0.0.0.0 是為了讓手機經區網或私人 VPN 開後台；設備在 NAT 後面且不轉埠，外網連不到。
  "Urls": "http://0.0.0.0:5090",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "ConnectionString": "Data Source=Data/memehelper.db"
  },
  "Storage": {
    "ImageRoot": "Data/images"
  },
  "Search": {
    "MaxListResults": 20
  },
  // Directory 留空就不備份。實際路徑因設備而異，填在 appsettings.Local.json。
  "Backup": {
    "Directory": "",
    "KeepCount": 14
  },
  // BotToken 與 AllowedUserIds 放 appsettings.Local.json，這裡留空只是讓區段形狀一目了然。
  "Telegram": {
    "BotToken": "",
    "AllowedUserIds": []
  }
}
