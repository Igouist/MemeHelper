<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Swagger 的說明文字來自 XML 註解檔；CS1591（公開成員缺少註解）在
         TreatWarningsAsErrors 下會變成建置錯誤，而本專案的註解慣例是解釋為什麼，
         不逐一覆蓋每個成員，所以關掉。 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MemeHelper.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Migrations\*.sql" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Telegram.Bot" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="dbup-core" />
    <PackageReference Include="dbup-sqlite" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>
</Project>
