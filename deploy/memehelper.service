[Unit]
Description=MemeHelper Telegram bot and admin API
# 不寫 After=network-online.target：user unit 看不到 system 的 target，寫了也沒作用。
# 開機時網路還沒好，polling 會自己每 10 秒重試。

[Service]
Type=notify
ExecStart=%h/Apps/MemeHelper/MemeHelper.Api
WorkingDirectory=%h/Apps/MemeHelper
Restart=always
RestartSec=10
TimeoutStopSec=60

[Install]
WantedBy=default.target
